      "rule": "preflight",
      "expect": "accept",
      "payload": {"event": "created", "locator": "preflights/run-0123456789abcdef0123456789abcdef/writer/preflight-v1.md", "digest": "sha256:preflight", "agent_name_path": "writer", "run_path_id": "run-0123456789abcdef0123456789abcdef"}
    },
    {
      "id": "matrix-12-reused-preflight",
      "matrix": true,
      "scenario": "Reused preflight",
      "rule": "preflight",
      "expect": "accept",
