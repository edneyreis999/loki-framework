{
  "schema_version": 1,
  "fixture_group": "input-path-and-preflight",
  "cases": [
    {
      "id": "matrix-01-empty-demand",
      "matrix": true,
      "scenario": "Empty demand",
      "rule": "demand",
      "expect": "reject",
      "error": "DEMAND_EMPTY",
      "payload": {"kind": "inline", "valid_utf8": true, "content": "", "classification_source": "explicit-caller-or-adapter"}
    },
    {
      "id": "matrix-02-invalid-analysis",
      "matrix": true,
      "scenario": "Missing/unreadable/non-Markdown analysis",
      "rule": "analysis",
      "expect": "reject",
      "error": "ANALYSIS_INVALID",
      "payload": {"exists": false, "readable": false, "regular": false, "nonempty": false, "path": "analysis.txt"}
    },
    {
      "id": "matrix-03-material-contradiction",
      "matrix": true,
      "scenario": "Material contradiction",
      "rule": "contradiction",
      "expect": "reject",
      "error": "MATERIAL_CONTRADICTION",
      "payload": {"material": true, "source_refs": ["demand#line-1", "analysis.md#restriction"]}
    },
    {
      "id": "matrix-04-inferred-target",
      "matrix": true,
      "scenario": "Target inferred beyond explicit demand",
      "rule": "target",
      "expect": "accept",
      "payload": {
        "target": "src/inferred.py",
        "planned_targets": ["src/inferred.py"],
        "inferred": true,
        "decision": {"rationale": "required integration", "demand_or_ac_relation": "AC-4", "evidence": "analysis.md#integration", "impact": "adds route", "validator": "pytest route"}
      }
    },
    {
      "id": "matrix-05-unplanned-target",
      "matrix": true,
      "scenario": "Target absent from validated plan",
      "rule": "target",
      "expect": "reject",
      "error": "TARGET_UNPLANNED",
      "payload": {"target": "src/unplanned.py", "planned_targets": ["src/planned.py"], "inferred": false, "bytes_unchanged_on_rejection": true}
    },
    {
      "id": "matrix-06-unsafe-plan-path",
      "matrix": true,
      "scenario": "Absolute/traversing/backslash/symlink plan path",
      "rule": "plan-path",
      "expect": "reject",
      "error": "PLAN_PATH_UNSAFE",
      "payload": {"path": "/tmp/escape", "symlink_ancestor": false, "destination_symlink": false, "canonical_contained": false, "base_usable": true}
    },
    {
      "id": "matrix-07-source-only-cold-start",
      "matrix": true,
      "scenario": "Source-only valid plan directory",
      "rule": "plan-directory",
      "expect": "accept",
      "payload": {"mode": "cold-start", "managed_entries": [], "source_entries": ["technical-analysis.md"], "create_exclusive": true}
    },
    {
      "id": "matrix-08-managed-collision",
      "matrix": true,
      "scenario": "Managed plan collision",
      "rule": "plan-directory",
      "expect": "reject",
      "error": "RESUME_STATE_MISSING",
      "payload": {"mode": "resume", "authoritative_state": false, "matching_identity": false, "matching_input_digests": false}
    },
    {
      "id": "matrix-11-new-preflight",
      "matrix": true,
