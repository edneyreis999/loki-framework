<?xml version="1.0" encoding="UTF-8"?>
<agent_run_report schema_version="5">
  <identity>
    <run_id>{{run_id}}</run_id>
    <phase>{{phase}}</phase>
    <agent_run_id>{{agent_run_id}}</agent_run_id>
    <handoff_id>{{handoff_id}}</handoff_id>
    <agent_name>{{agent_name}}</agent_name>
    <owner>{{owner}}</owner>
    <parallel_group_id>{{parallel_group_id}}</parallel_group_id>
  </identity>
  <evidence>
    <evidence_manifest_path>{{evidence_manifest_path}}</evidence_manifest_path>
    <evidence_status>{{evidence_status}}</evidence_status>
    <capture_trigger>{{capture_trigger}}</capture_trigger>
    <capture_target>{{capture_target}}</capture_target>
  </evidence>
  <execution_knowledge>
    <capture_id>{{capture_id}}</capture_id>
    <material>{{capture_material}}</material>
    <target_entry>{{knowledge_target_entry}}</target_entry>
    <state>{{knowledge_capture_state}}</state>
    <reason>{{knowledge_capture_reason}}</reason>
    <minimum_next_path>{{knowledge_minimum_next_path}}</minimum_next_path>
  </execution_knowledge>
  <write_test_review schema_version="1">
    <policy_ref>{{review_policy_ref}}</policy_ref>
    <policy_digest>{{review_policy_digest}}</policy_digest>
    <execution_id>{{review_execution_id}}</execution_id>
    <checkpoint_ref checkpoint_id="{{review_checkpoint_id}}">{{review_checkpoint_ref}}</checkpoint_ref>
    <coverage_digest>{{review_coverage_digest}}</coverage_digest>
    <covered_write_handoff_ids><handoff_id>{{covered_write_handoff_id}}</handoff_id></covered_write_handoff_ids>
    <review_lineage>
      <review_handoff_id>{{review_handoff_id_or_null}}</review_handoff_id>
      <review_agent_run_id>{{review_agent_run_id_or_null}}</review_agent_run_id>
      <evidence_ref>{{review_evidence_ref_or_null}}</evidence_ref>
    </review_lineage>
    <outcome>
      <status>{{review_checkpoint_status}}</status>
      <review_agent_raw_status>{{review_agent_raw_status_or_null}}</review_agent_raw_status>
      <execution_status_effect>none</execution_status_effect>
      <reason required_for="skipped-no-material-write skipped-agent-unavailable failed-consultive outcome-unknown">{{review_reason_or_null}}</reason>
    </outcome>
    <findings>
      <finding finding_id="{{review_finding_id}}">
        <summary>{{review_finding_summary}}</summary>
        <risk_ref>{{review_risk_ref}}</risk_ref>
        <backlog_ref>{{review_backlog_ref}}</backlog_ref>
      </finding>
    </findings>
    <risk_refs><risk_ref>{{review_risk_ref}}</risk_ref></risk_refs>
    <backlog_refs><backlog_ref>{{review_backlog_ref}}</backlog_ref></backlog_refs>
  </write_test_review>
  <selection>
    <selection_reason>{{selection_reason}}</selection_reason>
  </selection>
  <write_contract>
    <write_mode>{{write_mode}}</write_mode>
    <target_files>
      <target_file>{{target_file}}</target_file>
    </target_files>
    <allowed_writes>
      <allowed_write>{{allowed_write}}</allowed_write>
    </allowed_writes>
    <forbidden_writes>
      <forbidden_write>{{forbidden_write}}</forbidden_write>
    </forbidden_writes>
  </write_contract>
  <validators>
    <validator name="{{validator_name}}">
      <command>{{validator_command}}</command>
      <status>pending</status>
    </validator>
  </validators>
  <gates>
    <gate type="{{gate_type}}">
      <status>pending</status>
      <notes>{{gate_notes}}</notes>
    </gate>
  </gates>
  <freshness_signature>
    <input_path>{{input_path}}</input_path>
    <upstream_output>{{upstream_output}}</upstream_output>
    <decision_gate_id>{{decision_gate_id}}</decision_gate_id>
  </freshness_signature>
  <operational_refs>
    <research_packets>
      <packet_ref packet_id="{{packet_id}}" revision="{{packet_revision}}">
        <path>{{packet_path}}</path>
        <hash algorithm="sha-256">{{packet_sha256}}</hash>
      </packet_ref>
    </research_packets>
    <publication_batches>
      <batch_ref batch_id="{{batch_id}}">
        <path>{{batch_path}}</path>
      </batch_ref>
    </publication_batches>
    <continuation>
      <logical_status>{{continuation_status}}</logical_status>
      <continuation_ref>{{continuation_ref_or_null}}</continuation_ref>
      <next_destination>{{continuation_destination_or_null}}</next_destination>
    </continuation>
    <materialization>
      <materialization_ref>{{materialization_ref}}</materialization_ref>
    </materialization>
  </operational_refs>
  <completion>
    <status>pending</status>
    <report_path>{{report_path}}</report_path>
    <evidence>
      <item>{{evidence_item}}</item>
    </evidence>
    <blockers>
      <blocker>{{blocker}}</blocker>
    </blockers>
    <retrospective_required>{{retrospective_required}}</retrospective_required>
  </completion>
</agent_run_report>
