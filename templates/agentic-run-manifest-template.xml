<?xml version="1.0" encoding="UTF-8"?>
<agentic_run_manifest schema_version="4">
  <run>
    <run_id>{{run_id}}</run_id>
    <command>loki-agentic-development</command>
    <status>draft</status>
    <current_phase>{{current_phase}}</current_phase>
    <created_at>{{created_at}}</created_at>
    <updated_at>{{updated_at}}</updated_at>
  </run>
  <demand>
    <source>{{demand_source}}</source>
    <summary>{{demand_summary}}</summary>
    <scope>{{scope}}</scope>
  </demand>
  <freshness_signature>
    <input_path>{{input_path}}</input_path>
    <input_mtime>{{input_mtime}}</input_mtime>
    <input_hash optional="true">{{input_hash}}</input_hash>
    <decision_gate_id>{{decision_gate_id}}</decision_gate_id>
  </freshness_signature>
  <selected_agents>
    <selected_agent name="{{agent_name}}">
      <selection_reason>{{selection_reason}}</selection_reason>
      <capability_tags>
        <tag>{{capability_tag}}</tag>
      </capability_tags>
      <phase_roles>
        <role>{{phase_role}}</role>
      </phase_roles>
      <agentic_modes>
        <mode>{{agentic_mode}}</mode>
      </agentic_modes>
      <write_class>{{write_class}}</write_class>
      <parallel_safe>{{parallel_safe}}</parallel_safe>
      <risk_tags>
        <tag>{{risk_tag}}</tag>
      </risk_tags>
    </selected_agent>
  </selected_agents>
  <handoffs>
    <handoff>
      <handoff_id>{{handoff_id}}</handoff_id>
      <evidence_id>{{evidence_id}}</evidence_id>
      <evidence_manifest_path>{{evidence_manifest_path}}</evidence_manifest_path>
      <agent_run_id>{{agent_run_id}}</agent_run_id>
      <agent_name>{{agent_name}}</agent_name>
      <phase>{{phase}}</phase>
      <owner>{{owner}}</owner>
      <parallel_group_id>{{parallel_group_id}}</parallel_group_id>
      <target_files>
        <target_file>{{target_file}}</target_file>
      </target_files>
      <status>planned</status>
    </handoff>
  </handoffs>
  <evidence_policy><mode>evidence-first</mode><legacy_retrospective_fallback>false</legacy_retrospective_fallback></evidence_policy>
  <execution_knowledge_policy>
    <mode>persist-first-nonblocking-enrichment</mode>
    <promotion_owner>loki-continuous-improvement</promotion_owner>
    <final_checkpoint_wait>false</final_checkpoint_wait>
  </execution_knowledge_policy>
  <execution_knowledge_captures>
    <capture>
      <capture_id>{{capture_id}}</capture_id>
      <agent_run_id>{{agent_run_id}}</agent_run_id>
      <handoff_id>{{handoff_id}}</handoff_id>
      <material>{{capture_material}}</material>
      <target_entry>{{knowledge_target_entry}}</target_entry>
      <state>{{knowledge_capture_state}}</state>
      <reason>{{knowledge_capture_reason}}</reason>
      <minimum_next_path>{{knowledge_minimum_next_path}}</minimum_next_path>
    </capture>
  </execution_knowledge_captures>
  <write_test_review schema_version="1" legacy_reader_optional="true">
    <request>
      <requested_frequency>{{review_requested_frequency}}</requested_frequency>
      <provenance>{{review_frequency_provenance}}</provenance>
    </request>
    <plan_executor_handoff>
      <handoff_id>{{plan_executor_handoff_id}}</handoff_id>
      <execution_scope>plano</execution_scope>
      <tasks_md>{{tasks_md}}</tasks_md>
      <status>{{plan_executor_handoff_status}}</status>
    </plan_executor_handoff>
    <reconciled_policy>
      <policy_ref>{{review_policy_ref}}</policy_ref>
      <policy_digest>{{review_policy_digest}}</policy_digest>
      <effective_frequency>{{review_effective_frequency}}</effective_frequency>
      <terminal_scope>{{review_terminal_scope}}</terminal_scope>
      <selected_agent_name>{{review_selected_agent_or_null}}</selected_agent_name>
      <selection_reason>{{review_selection_reason}}</selection_reason>
    </reconciled_policy>
    <checkpoints>
      <checkpoint checkpoint_id="{{review_checkpoint_id}}">
        <execution_id>{{review_execution_id}}</execution_id>
        <policy_digest>{{review_policy_digest}}</policy_digest>
        <boundary_type>{{review_boundary_type}}</boundary_type>
        <boundary_ref>{{review_boundary_ref}}</boundary_ref>
        <coverage_digest>{{review_coverage_digest}}</coverage_digest>
        <coverage_manifest schema_version="1">
          <handoffs>
            <handoff>
              <handoff_id>{{covered_write_handoff_id}}</handoff_id>
              <completion_ref>{{covered_completion_ref}}</completion_ref>
              <evidence_ref>{{covered_evidence_ref}}</evidence_ref>
              <changed_files><file><path>{{covered_changed_path}}</path><sha256>{{covered_changed_sha256}}</sha256></file></changed_files>
            </handoff>
          </handoffs>
          <reviewer>
            <name>{{review_selected_agent_or_null}}</name>
            <contract_version>{{review_agent_contract_version}}</contract_version>
            <selection_configuration_digest>{{review_selection_configuration_digest}}</selection_configuration_digest>
          </reviewer>
        </coverage_manifest>
        <covered_write_handoff_ids><handoff_id>{{covered_write_handoff_id}}</handoff_id></covered_write_handoff_ids>
        <findings/>
        <status>{{review_checkpoint_status}}</status>
        <review_handoff_id>{{review_handoff_id_or_null}}</review_handoff_id>
        <review_agent_run_id>{{review_agent_run_id_or_null}}</review_agent_run_id>
        <review_agent_raw_status>{{review_agent_raw_status_or_null}}</review_agent_raw_status>
        <evidence_ref>{{review_evidence_ref_or_null}}</evidence_ref>
        <risk_refs><risk_ref>{{review_risk_ref}}</risk_ref></risk_refs>
        <backlog_refs><backlog_ref>{{review_backlog_ref}}</backlog_ref></backlog_refs>
        <execution_status_effect>none</execution_status_effect>
        <reason required_for="skipped-no-material-write skipped-agent-unavailable failed-consultive outcome-unknown">{{review_reason_or_null}}</reason>
      </checkpoint>
    </checkpoints>
    <risks><risk_ref>{{review_risk_ref}}</risk_ref></risks>
    <state_errors>
      <state_error code="{{review_state_error_code}}">
        <reason>{{review_state_error_reason}}</reason>
        <next_action>{{review_state_error_next_action}}</next_action>
      </state_error>
    </state_errors>
    <next_action>{{review_next_action}}</next_action>
  </write_test_review>
  <decision_gates>
    <decision_gate id="{{decision_gate_id}}">
      <category>{{decision_gate_category}}</category>
      <status>resolved</status>
      <question>{{decision_gate_question}}</question>
      <resolution>{{decision_gate_resolution}}</resolution>
      <affected_outputs>
        <output>{{affected_output}}</output>
      </affected_outputs>
    </decision_gate>
  </decision_gates>
  <validators>
    <validator name="validate-agentic-run-state">
      <command>python3 scripts/validate-agentic-run-state.py {{run_directory}}</command>
      <status>pending</status>
    </validator>
  </validators>
  <next_action>{{next_action}}</next_action>
</agentic_run_manifest>
