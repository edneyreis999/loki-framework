{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loki-framework.local/schemas/analytic-inference-catalog-v1.json",
  "title": "Analytic Inference Catalog Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "technology", "aliases", "active_limit", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"type": "string", "minLength": 1},
    "technology": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "active_limit": {"type": "integer", "minimum": 0},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/index_entry"}
    }
  },
  "$defs": {
    "index_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inference_id", "revision", "status", "summary", "technologies", "surfaces", "objectives", "signals", "locator"],
      "properties": {
        "inference_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["active", "protected", "redirect", "tombstone"]},
        "summary": {"type": "string"},
        "technologies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "surfaces": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "objectives": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "signals": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "inference_id", "revision", "status", "statement", "applicability", "investigation", "provenance", "lineage", "snapshot"],
      "properties": {
        "schema_version": {"const": 1},
        "inference_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["active", "protected", "redirect", "tombstone"]},
        "statement": {"type": "string", "minLength": 1},
        "applicability": {"$ref": "#/$defs/applicability"},
        "investigation": {"$ref": "#/$defs/investigation"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "lineage": {"$ref": "#/$defs/lineage"},
        "snapshot": {"$ref": "#/$defs/snapshot"}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technologies", "versions", "surfaces", "objectives", "signals", "exclusions"],
      "properties": {
        "technologies": {"$ref": "#/$defs/string_array"},
        "versions": {"$ref": "#/$defs/string_array"},
        "surfaces": {"$ref": "#/$defs/string_array"},
        "objectives": {"$ref": "#/$defs/string_array"},
        "signals": {"$ref": "#/$defs/string_array"},
        "exclusions": {"$ref": "#/$defs/string_array"}
      }
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demand_relation", "confirm_or_reject_evidence", "potential_impact", "cost", "stop_condition", "suggested_capabilities"],
      "properties": {
        "demand_relation": {"type": "string"},
        "confirm_or_reject_evidence": {"$ref": "#/$defs/string_array"},
        "potential_impact": {"type": "string"},
        "cost": {"enum": ["low", "medium", "high", "unknown", "unsupported"]},
        "stop_condition": {"type": "string"},
        "suggested_capabilities": {"$ref": "#/$defs/string_array"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "accepted_evidence_refs", "freshness"],
      "properties": {
        "source_refs": {"$ref": "#/$defs/string_array"},
        "accepted_evidence_refs": {"$ref": "#/$defs/string_array"},
        "freshness": {"enum": ["current", "stale", "unknown", "unsupported"]}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supersedes", "merged_from", "redirect_to", "tombstone"],
      "properties": {
        "supersedes": {"$ref": "#/$defs/id_array"},
        "merged_from": {"$ref": "#/$defs/id_array"},
        "redirect_to": {"type": ["string", "null"], "minLength": 1},
        "tombstone": {"type": ["object", "null"]}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm_version", "components", "score", "as_of_event", "freshness", "denominators"],
      "properties": {
        "algorithm_version": {"type": "string", "minLength": 1},
        "components": {"$ref": "#/$defs/components"},
        "score": {"type": "integer"},
        "as_of_event": {"type": ["string", "null"], "minLength": 1},
        "freshness": {"enum": ["current", "stale", "unknown", "unsupported"]},
        "denominators": {"type": "object"}
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_count", "investigated_count", "validated_count", "rejected_count", "material_findings_count", "tasks_helped_count", "false_positive_count", "repeated_evidence_count", "stale_count"],
      "properties": {
        "selected_count": {"type": "integer", "minimum": 0},
        "investigated_count": {"type": "integer", "minimum": 0},
        "validated_count": {"type": "integer", "minimum": 0},
        "rejected_count": {"type": "integer", "minimum": 0},
        "material_findings_count": {"type": "integer", "minimum": 0},
        "tasks_helped_count": {"type": "integer", "minimum": 0},
        "false_positive_count": {"type": "integer", "minimum": 0},
        "repeated_evidence_count": {"type": "integer", "minimum": 0},
        "stale_count": {"type": "integer", "minimum": 0}
      }
    },
    "string_array": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "id_array": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
