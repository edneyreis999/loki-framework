{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loki-framework.local/schemas/analytic-inference-registry-v1.json",
  "title": "Analytic Inference Consumer Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state_layout", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "state_layout": {"const": "analytic-inference-consumer-v1"},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/registry_entry"}
    }
  },
  "$defs": {
    "path_segment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "registry_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technology", "aliases", "catalog_id", "locator"],
      "properties": {
        "technology": {"$ref": "#/$defs/path_segment_id"},
        "aliases": {
          "type": "array",
          "items": {"$ref": "#/$defs/path_segment_id"},
          "uniqueItems": true
        },
        "catalog_id": {"$ref": "#/$defs/path_segment_id"},
        "locator": {
          "type": "string",
          "pattern": "^catalogs/[a-z0-9][a-z0-9._-]*/index\\.json$"
        }
      }
    }
  }
}
